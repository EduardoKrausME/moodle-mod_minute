{{!
    @template mod_minute/view

    Example context (json):
    {
        *Example context (json):*
    }
}}
<div class="mod-minute">
    {{#hasintro}}
        <div class="mb-4">{{{intro}}}</div>
    {{/hasintro}}

    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5 mb-3">{{#str}}question, mod_minute{{/str}}</h3>
            <div class="lead mb-3">{{{prompt}}}</div>
            <div class="text-muted small">
                {{characterlimittext}}
                {{#haswindow}} · {{window}}{{/haswindow}}
            </div>
        </div>
    </div>

    {{#canreport}}
        <div class="card mb-4 border-secondary">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h3 class="h5 mb-0">{{#str}}teachercontrols, mod_minute{{/str}}</h3>
                    <a class="btn btn-outline-primary" href="{{{reporturl}}}">{{#str}}viewreport, mod_minute{{/str}}</a>
                </div>

                {{#requireip}}
                    <div class="mb-3">
                        <strong>{{#str}}iprestriction, mod_minute{{/str}}</strong>
                        <div class="small text-muted mb-2">
                            {{#hasteacherip}}{{currentteacheriptext}}{{/hasteacherip}}
                            {{^hasteacherip}}{{#str}}teachernotconfigured, mod_minute{{/str}}{{/hasteacherip}}
                        </div>
                        <form method="post" action="{{actionurl}}">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="action" value="captureip">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <button type="submit" class="btn btn-sm btn-secondary">{{#str}}
                                usecurrentip, mod_minute{{/str}}</button>
                        </form>
                    </div>
                {{/requireip}}

                {{#requirelocation}}
                    <div>
                        <strong>{{#str}}locationrestriction, mod_minute{{/str}}</strong>
                        <div class="small text-muted mb-2">
                            {{#hasreferencelocation}}{{referencelocationtext}} · {{radiustext}}{{/hasreferencelocation}}
                            {{^hasreferencelocation}}{{#str}}
                                locationnotconfiguredteacher, mod_minute{{/str}}{{/hasreferencelocation}}
                        </div>
                        <form id="minute-teacher-location-form" method="post" action="{{actionurl}}">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="action" value="capturelocation">
                            <input type="hidden" name="sesskey" value="{{sesskey}}">
                            <input type="hidden" id="minute-teacher-latitude" name="latitude" value="">
                            <input type="hidden" id="minute-teacher-longitude" name="longitude" value="">
                            <button type="button" id="minute-teacher-location" class="btn btn-sm btn-secondary">{{#str}}
                                usecurrentlocation, mod_minute{{/str}}</button>
                            <span id="minute-teacher-location-status" class="small text-muted ms-2"></span>
                        </form>
                    </div>
                {{/requirelocation}}
            </div>
        </div>
    {{/canreport}}

    {{#cansubmit}}
        {{#isopen}}
            <form method="post" action="{{actionurl}}" class="card">
                <div class="card-body">
                    <input type="hidden" name="id" value="{{id}}">
                    <input type="hidden" name="action" value="submit">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <input type="hidden" id="minute-latitude" name="latitude" value="">
                    <input type="hidden" id="minute-longitude" name="longitude" value="">
                    <input type="hidden" id="minute-accuracy" name="accuracy" value="">

                    <label for="minute-response" class="form-label fw-bold">{{#str}}
                        yourresponse, mod_minute{{/str}}</label>
                    <textarea id="minute-response" name="response" class="form-control" rows="5"
                              maxlength="{{maxchars}}" required>{{response}}</textarea>
                    <div class="form-text">{{characterlimittext}}</div>

                    {{#requireip}}
                        <div class="alert alert-info mt-3 mb-0 py-2">{{#str}}studentipnotice, mod_minute{{/str}}</div>
                    {{/requireip}}

                    {{#requirelocation}}
                        <div class="mt-3">
                            <button type="button" id="minute-capture-location"
                                    class="btn btn-outline-secondary">{{#str}}sharelocation, mod_minute{{/str}}</button>
                            <span id="minute-location-status" class="small text-muted ms-2"></span>
                        </div>
                    {{/requirelocation}}

                    <div class="mt-3 d-flex align-items-center gap-3">
                        <button type="submit" id="minute-submit" class="btn btn-primary"
                                {{#requirelocation}}disabled{{/requirelocation}}>
                            {{#hassubmission}}{{#str}}updateresponse, mod_minute{{/str}}{{/hassubmission}}
                            {{^hassubmission}}{{#str}}submitresponse, mod_minute{{/str}}{{/hassubmission}}
                        </button>
                        {{#hassubmission}}<span class="small text-muted">{{lastsavedtext}}</span>{{/hassubmission}}
                    </div>
                </div>
            </form>
        {{/isopen}}
        {{^isopen}}
            <div class="alert alert-warning">{{closedmessage}}</div>
            {{#hassubmission}}
                <div class="card">
                    <div class="card-body">
                        <h3 class="h5">{{#str}}yourresponse, mod_minute{{/str}}</h3>
                        <div class="white-space-pre-wrap">{{response}}</div>
                    </div>
                </div>
            {{/hassubmission}}
        {{/isopen}}
    {{/cansubmit}}
</div>
